              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"book_id\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/borrowings",
              "host": ["{{base_url}}"],
              "path": ["api", "borrowings"]
            }
          }
        },
        {
          "name": "Get My Borrowings",
          "request": {
            "method": "GET",
